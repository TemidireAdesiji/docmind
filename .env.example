# DocMind Configuration
# Copy this file to .env and adjust as needed.

# --- LLM Provider ---
# Model identifier for the Ollama-hosted LLM.
DOCMIND_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
DOCMIND_LLM_TEMPERATURE=0

# --- Embedding Models ---
DOCMIND_DENSE_EMBEDDING=sentence-transformers/all-mpnet-base-v2
DOCMIND_SPARSE_EMBEDDING=Qdrant/bm25

# --- Tracing (optional) ---
# Enable Langfuse-based observability.
DOCMIND_TRACING_ENABLED=false
DOCMIND_TRACING_PUBLIC_KEY=pk-lf-...
DOCMIND_TRACING_SECRET_KEY=sk-lf-...
DOCMIND_TRACING_HOST=http://localhost:3000
